#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
config_root="${HOME}/.config/host-ingress"
ngrok_env_file="${config_root}/env.ngrok"
caddy_env_file="${config_root}/env.caddy"
oauth_env_file="${config_root}/env.oauth"
caddy_bin="${HOME}/.local/bin/caddy"
node_bin="${HOME}/.local/bin/node"
ngrok_bin="${HOME}/.local/bin/ngrok"
runtime_root="${config_root}/runtime"
user_unit_dir="${HOME}/.config/systemd/user"
staging_root=""
release_dir=""
rollback_root=""
current_link_tmp=""
previous_link=""
previous_release_dir=""
activation_started=0
deployment_succeeded=0
host_oauth_unit_changed=1
host_ingress_unit_changed=1
host_ngrok_unit_changed=1
oauth_runtime_changed=1
ngrok_runtime_changed=1

restore_previous() {
  (( activation_started )) || return 0
  (( deployment_succeeded )) && return 0
  echo "deployment failed after activation; restoring previous ingress release" >&2
  local rollback_failed=0

  if [[ -n "${previous_link}" ]]; then
    local restore_link="${runtime_root}/.restore-$$"
    ln -s "${previous_link}" "${restore_link}" && mv -Tf -- "${restore_link}" "${runtime_root}/current" || rollback_failed=1
  else
    rm -f -- "${runtime_root}/current" || rollback_failed=1
  fi

  for unit in host-oauth.service host-ingress.service host-ngrok.service; do
    if [[ -f "${rollback_root}/${unit}" ]]; then
      install -m 0644 "${rollback_root}/${unit}" "${user_unit_dir}/${unit}" || rollback_failed=1
    else
      rm -f -- "${user_unit_dir}/${unit}" || rollback_failed=1
    fi
  done
  systemctl --user daemon-reload || rollback_failed=1
  if [[ -n "${previous_link}" ]]; then
    if (( host_oauth_unit_changed || oauth_runtime_changed )); then
      systemctl --user restart host-oauth.service || rollback_failed=1
    fi
    if (( host_ingress_unit_changed )); then
      systemctl --user restart host-ingress.service || rollback_failed=1
    else
      systemctl --user reload host-ingress.service || rollback_failed=1
    fi
    if (( host_ngrok_unit_changed || ngrok_runtime_changed )); then
      systemctl --user restart host-ngrok.service || rollback_failed=1
    fi
    for unit in host-oauth.service host-ingress.service host-ngrok.service; do
      systemctl --user is-active --quiet "${unit}" || rollback_failed=1
    done
    local restored_link restored_release
    restored_link="$(readlink "${runtime_root}/current" 2>/dev/null || true)"
    restored_release="$(readlink -f "${runtime_root}/current" 2>/dev/null || true)"
    if [[ "${restored_link}" != "${previous_link}" || "${restored_release}" != "${previous_release_dir}" ]]; then
      echo "ROLLBACK SELECTOR FAILED: runtime/current does not point to the exact previous release (expected '${previous_link}' -> '${previous_release_dir}', got '${restored_link}' -> '${restored_release}')" >&2
      rollback_failed=1
    fi
    curl -fsS --max-time 2 http://127.0.0.1:9001/healthz >/dev/null || rollback_failed=1
    if [[ -f "${previous_release_dir}/transport/ngrok/transport.mjs" ]]; then
      node "${previous_release_dir}/transport/ngrok/transport.mjs" status >/dev/null 2>&1 || rollback_failed=1
      node "${previous_release_dir}/scripts/check-apps.mjs" gates-public >/dev/null 2>&1 || rollback_failed=1
    else
      rollback_failed=1
    fi
  else
    systemctl --user stop host-ngrok.service host-ingress.service host-oauth.service || rollback_failed=1
  fi
  [[ -n "${release_dir}" && -d "${release_dir}" ]] && rm -rf -- "${release_dir}"
  if (( rollback_failed )); then
    echo "ROLLBACK FAILED: prior release recovery or health verification failed; original deployment failure remains the primary error" >&2
    return 1
  fi
  echo "rollback verified: prior OAuth, Caddy, and tunnel services are healthy" >&2
}

cleanup() {
  local status=$?
  if ! restore_previous; then
    echo "deployment exit status ${status}; rollback failed (see recovery checks above)" >&2
  fi
  [[ -n "${staging_root}" && -d "${staging_root}" ]] && rm -rf -- "${staging_root}"
  [[ -n "${current_link_tmp}" && -L "${current_link_tmp}" ]] && rm -f -- "${current_link_tmp}"
  [[ -n "${rollback_root}" && -d "${rollback_root}" ]] && rm -rf -- "${rollback_root}"
  exit "${status}"
}
trap cleanup EXIT

for executable in "${caddy_bin}" "${node_bin}" "${ngrok_bin}"; do
  if [[ ! -x "${executable}" ]]; then
    echo "missing executable ${executable}" >&2
    exit 1
  fi
done
python_bin="$(command -v python3 || true)"
if [[ -z "${python_bin}" ]]; then
  echo "python3 is required" >&2
  exit 1
fi

for env_file in "${ngrok_env_file}" "${caddy_env_file}" "${oauth_env_file}"; do
  [[ -f "${env_file}" ]] || { echo "missing ${env_file}" >&2; exit 1; }
  [[ "$(stat -c '%a' "${env_file}")" == "600" ]] || { echo "${env_file} must have mode 0600" >&2; exit 1; }
done
origin_from_env() {
  local file="$1"
  (
    unset PUBLIC_ORIGIN
    set -a
    # shellcheck disable=SC1090
    source "${file}"
    set +a
    node "${root}/lib/origin.mjs"
  )
}
ngrok_origin="$(origin_from_env "${ngrok_env_file}")"
oauth_origin="$(origin_from_env "${oauth_env_file}")"
[[ "${ngrok_origin}" == "${oauth_origin}" ]] || {
  echo "env.ngrok and env.oauth PUBLIC_ORIGIN values must match" >&2
  exit 1
}
set -a
# shellcheck disable=SC1090
source "${ngrok_env_file}"
set +a
node "${root}/lib/origin.mjs" >/dev/null

validate_caddy() {
  local config="$1"
  (
    unset CODEX_CONNECT_BASIC_AUTH_USER CODEX_CONNECT_BASIC_AUTH_HASH
    set -a
    # shellcheck disable=SC1090
    source "${caddy_env_file}"
    set +a
    "${caddy_bin}" validate --config "${config}" --adapter caddyfile >/dev/null
  )
}

node "${root}/transport/ngrok/transport.mjs" validate

if [[ ! -f "${config_root}/oauth-secrets.json" ]]; then
  echo "initialize OAuth first: node scripts/init-oauth.mjs" >&2
  exit 1
fi
if [[ "$(stat -c '%a' "${config_root}/oauth-secrets.json")" != "600" ]]; then
  echo "OAuth secrets must have mode 0600" >&2
  exit 1
fi

source_git_sha="unknown"
if git -C "${root}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if [[ -n "$(git -C "${root}" status --porcelain --untracked-files=normal)" ]]; then
    echo "refusing deployment from a dirty Git worktree; commit or clean the source first" >&2
    exit 1
  fi
  source_git_sha="$(git -C "${root}" rev-parse HEAD)"
fi

npm --prefix "${root}" ci --ignore-scripts --no-fund --no-audit
npm --prefix "${root}" test
systemd-analyze --user verify "${root}"/deploy/systemd/*.service

mkdir -p \
  "${HOME}/.local/state/host-ingress/logs" \
  "${HOME}/.config/caddy" \
  "${HOME}/.local/share/caddy" \
  "${runtime_root}/releases" \
  "${user_unit_dir}"
chmod 0700 "${HOME}/.local/state/host-ingress" "${HOME}/.local/state/host-ingress/logs" 2>/dev/null || true

managed_marker="# Managed by host-ingress; install with scripts/deploy."
for unit in host-oauth.service host-ingress.service host-ngrok.service; do
  destination="${user_unit_dir}/${unit}"
  source_unit="${root}/deploy/systemd/${unit}"
  if [[ -L "${destination}" ]]; then
    if [[ "$(readlink -f "${destination}")" != "${source_unit}" ]]; then
      echo "refusing to replace independently managed unit ${destination}" >&2
      exit 1
    fi
  elif [[ -e "${destination}" ]] && ! grep -Fqx "${managed_marker}" "${destination}"; then
    echo "refusing to replace independently managed unit ${destination}" >&2
    exit 1
  fi
done

if [[ -e "${runtime_root}/current" && ! -L "${runtime_root}/current" ]]; then
  echo "refusing to replace non-symlink runtime selector ${runtime_root}/current" >&2
  exit 1
fi
previous_link="$(readlink "${runtime_root}/current" 2>/dev/null || true)"
previous_release_dir="$(readlink -f "${runtime_root}/current" 2>/dev/null || true)"

release_id="$(date +%Y%m%d%H%M%S)-$$"
staging_root="${runtime_root}/.staging-${release_id}"
release_dir="${runtime_root}/releases/${release_id}"
mkdir "${staging_root}"
mkdir -p "${staging_root}/config" "${staging_root}/auth" "${staging_root}/lib" "${staging_root}/transport/ngrok" "${staging_root}/scripts"
install -m 0644 "${root}/Caddyfile" "${root}/package.json" "${root}/package-lock.json" "${staging_root}/"
install -m 0644 "${root}"/auth/*.mjs "${staging_root}/auth/"
npm --prefix "${staging_root}" ci --omit=dev --ignore-scripts --no-fund --no-audit
install -m 0644 "${root}"/lib/*.mjs "${staging_root}/lib/"
install -m 0644 "${root}/config/codex-connect.json" "${root}/config/opencode-connect.json" "${root}/config/transport-assurance.json" "${staging_root}/config/"
install -m 0644 "${root}/transport/assurance.mjs" "${root}/transport/openai-network.json" "${staging_root}/transport/"
install -m 0644 "${root}"/transport/ngrok/* "${staging_root}/transport/ngrok/"
install -m 0644 "${root}"/scripts/check-*.mjs "${root}/scripts/render-caddy.mjs" "${root}/scripts/network.mjs" "${staging_root}/scripts/"
node "${staging_root}/scripts/render-caddy.mjs" "${staging_root}"

validate_caddy "${staging_root}/Caddyfile"
content_sha256="$("${root}/scripts/release-digest" "${staging_root}")"
"${python_bin}" - "${staging_root}/release-manifest.json" "${release_id}" "${source_git_sha}" "${content_sha256}" <<'PY'
import json, sys
from pathlib import Path
path, release_id, git_sha, digest = sys.argv[1:]
Path(path).write_text(json.dumps({
    "schemaVersion": 1,
    "releaseId": release_id,
    "gitSha": git_sha,
    "contentSha256": digest,
}, indent=2) + "\n")
PY
chmod 0644 "${staging_root}/release-manifest.json"
[[ "$("${root}/scripts/release-digest" "${staging_root}")" == "${content_sha256}" ]]

mv -- "${staging_root}" "${release_dir}"
staging_root=""

rollback_root="$(mktemp -d "${runtime_root}/.rollback-${release_id}-XXXXXX")"
for unit in host-oauth.service host-ingress.service host-ngrok.service; do
  [[ -f "${user_unit_dir}/${unit}" ]] && cp -a "${user_unit_dir}/${unit}" "${rollback_root}/${unit}"
done
if [[ -f "${rollback_root}/host-oauth.service" ]] && cmp -s "${root}/deploy/systemd/host-oauth.service" "${rollback_root}/host-oauth.service"; then
  host_oauth_unit_changed=0
fi
if [[ -f "${rollback_root}/host-ingress.service" ]] && cmp -s "${root}/deploy/systemd/host-ingress.service" "${rollback_root}/host-ingress.service"; then
  host_ingress_unit_changed=0
fi
if [[ -f "${rollback_root}/host-ngrok.service" ]] && cmp -s "${root}/deploy/systemd/host-ngrok.service" "${rollback_root}/host-ngrok.service"; then
  host_ngrok_unit_changed=0
fi
if [[ -n "${previous_release_dir}" && -d "${previous_release_dir}" ]]; then
  if diff -qr "${previous_release_dir}/auth" "${release_dir}/auth" >/dev/null \
      && cmp -s "${previous_release_dir}/lib/apps.mjs" "${release_dir}/lib/apps.mjs" \
      && cmp -s "${previous_release_dir}/lib/origin.mjs" "${release_dir}/lib/origin.mjs" \
      && cmp -s "${previous_release_dir}/config/codex-connect.json" "${release_dir}/config/codex-connect.json" \
      && cmp -s "${previous_release_dir}/config/opencode-connect.json" "${release_dir}/config/opencode-connect.json" \
      && cmp -s "${previous_release_dir}/package.json" "${release_dir}/package.json" \
      && cmp -s "${previous_release_dir}/package-lock.json" "${release_dir}/package-lock.json"; then
    oauth_runtime_changed=0
  fi
  if [[ -d "${previous_release_dir}/transport/ngrok" ]] \
      && diff -qr "${previous_release_dir}/transport/ngrok" "${release_dir}/transport/ngrok" >/dev/null \
      && cmp -s "${previous_release_dir}/lib/origin.mjs" "${release_dir}/lib/origin.mjs"; then
    ngrok_runtime_changed=0
  fi
fi
activation_started=1

install_unit() {
  local source="$1"
  local destination="$2"
  local temporary="${destination}.tmp-$$"
  install -m 0644 "${source}" "${temporary}"
  mv -f -- "${temporary}" "${destination}"
}
install_unit "${root}/deploy/systemd/host-ingress.service" "${user_unit_dir}/host-ingress.service"
install_unit "${root}/deploy/systemd/host-ngrok.service" "${user_unit_dir}/host-ngrok.service"
install_unit "${root}/deploy/systemd/host-oauth.service" "${user_unit_dir}/host-oauth.service"

current_link_tmp="${runtime_root}/.current-${release_id}"
ln -s "releases/${release_id}" "${current_link_tmp}"
mv -Tf -- "${current_link_tmp}" "${runtime_root}/current"
current_link_tmp=""

systemctl --user daemon-reload
systemctl --user enable host-oauth.service host-ingress.service host-ngrok.service >/dev/null
if (( host_oauth_unit_changed || oauth_runtime_changed )) || ! systemctl --user is-active --quiet host-oauth.service; then
  systemctl --user restart host-oauth.service
fi

oauth_ready=0
for attempt in {1..30}; do
  if curl -fsS --max-time 1 http://127.0.0.1:9001/healthz >/dev/null 2>&1; then
    oauth_ready=1
    break
  fi
  sleep 0.5
done
(( oauth_ready )) || { echo "OAuth service did not become ready" >&2; exit 1; }

if (( host_ingress_unit_changed )) || ! systemctl --user is-active --quiet host-ingress.service; then
  systemctl --user restart host-ingress.service
else
  # Reload atomically through Caddy's admin API. A restart can wait on
  # long-lived MCP requests and leave the public listener unavailable while
  # systemd waits for graceful shutdown.
  systemctl --user reload host-ingress.service
fi
if (( host_ngrok_unit_changed || ngrok_runtime_changed )) || ! systemctl --user is-active --quiet host-ngrok.service; then
  systemctl --user restart host-ngrok.service
fi

ngrok_ready=0
for attempt in {1..60}; do
  if node "${release_dir}/transport/ngrok/transport.mjs" status >/dev/null 2>&1 \
      && node "${release_dir}/scripts/check-apps.mjs" gates-public >/dev/null 2>&1; then
    ngrok_ready=1
    break
  fi
  sleep 0.5
done
(( ngrok_ready )) || { echo "ngrok tunnel, public auth gate, or edge policy did not become ready" >&2; exit 1; }

CHECK_PUBLIC=1 "${root}/scripts/check" ingress
"${root}/scripts/status"

deployment_succeeded=1
activation_started=0

echo "deployed host-ingress release ${release_id} (${source_git_sha}, ${content_sha256})"

# Retain the five newest canonical releases. Diagnostics and failed temporary
# releases are not runtime authority and are removed after a verified deployment.
current_abs="$(readlink -f "${runtime_root}/current")"
mapfile -t canonical_releases < <(find "${runtime_root}/releases" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | grep -E '^[0-9]{14}-[0-9]+$' | sort)
while (( ${#canonical_releases[@]} > 5 )); do
  candidate="${runtime_root}/releases/${canonical_releases[0]}"
  canonical_releases=("${canonical_releases[@]:1}")
  [[ "$(readlink -f "${candidate}")" == "${current_abs}" ]] || rm -rf -- "${candidate}"
done
find "${runtime_root}/releases" -mindepth 1 -maxdepth 1 -type d -name 'temp-*' ! -samefile "${current_abs}" -exec rm -rf -- {} + 2>/dev/null || true
